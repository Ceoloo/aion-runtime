{
  "name": "@aion/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "AION runtime host \u2014 the platform composition root. Boots AION Core over AION Data's durable Postgres adapters, exposes health/readiness, runs migrations, emits structured logs, and builds the one provider-neutral container image every deployment profile runs. Established by aion-docs ADR-002.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:deps": "node scripts/setup-deps.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "portability-check": "bash scripts/portability-check.sh",
    "acceptance": "bash scripts/local-acceptance.sh",
    "proof:mission001": "bash scripts/mission001-proof-matrix.sh",
    "proof:mission002": "bash scripts/mission002-proof-matrix.sh",
    "certify:platform-v01": "bash scripts/platform-v01-certification.sh",
    "certify:platform-v020": "bash scripts/platform-v020-certification.sh",
    "proof:mission003": "bash scripts/mission003-attack-suite.sh",
    "proof:mission004": "bash scripts/mission004-proof-matrix.sh",
    "proof:mission005": "bash scripts/mission005-proof-matrix.sh",
    "proof:mission006": "bash scripts/mission006-proof-matrix.sh",
    "proof:mission007": "bash scripts/mission007-proof-matrix.sh",
    "proof:mission008": "bash scripts/mission008-proof-matrix.sh",
    "proof:mission009": "bash scripts/mission009-proof-matrix.sh",
    "proof:ghl-phase-ab": "bash scripts/ghl-phase-ab-proof-matrix.sh",
    "proof:ghl-live-acceptance": "bash scripts/ghl-live-acceptance.sh",
    "test:aio17-ghl-fixtures": "npm run build && node --test dist/adapters/ghl/aio17-contract.fixtures.test.js",
    "proof:aio17-ghl-lead-workflow": "bash scripts/aio17-ghl-lead-workflow-proof.sh",
    "proof:ghl-live-capability": "node dist/ghl-live-capability-proof.js",
    "proof:ie002": "bash scripts/ie002-proof-matrix.sh",
    "test:outcomes-sessions": "npm run build && node --test dist/outcomes-sessions-gateway.test.js",
    "test:identity": "npm run build && node --test dist/auth/identity-plane.test.js"
  },
  "dependencies": {
    "@aion/core": "file:vendor/aion-core",
    "@aion/data": "file:vendor/aion-data",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
